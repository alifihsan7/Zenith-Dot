#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "zenith.manifest"
IDI_ZENITH_DOT ICON "zenith.ico"

IDD_SETTINGS DIALOGEX 0, 0, 478, 337
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Zenith Dot Settings"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "&General", IDC_SETTINGS_GENERAL, 12, 56, 98, 24, BS_OWNERDRAW
    PUSHBUTTON "&Appearance", IDC_SETTINGS_DISPLAY, 12, 84, 98, 24, BS_OWNERDRAW
    PUSHBUTTON "&Features", IDC_SETTINGS_FEATURES, 12, 112, 98, 24, BS_OWNERDRAW
    PUSHBUTTON "&About", IDC_SETTINGS_ABOUT, 12, 140, 98, 24, BS_OWNERDRAW
    CONTROL "Start with Windows", IDC_START_WITH_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 78, 274, 37
    PUSHBUTTON "Pill width", IDC_PILL_WIDTH, 144, 155, 312, 25, BS_OWNERDRAW
    PUSHBUTTON "Island size", IDC_ISLAND_SIZE, 144, 182, 312, 25, BS_OWNERDRAW
    PUSHBUTTON "Accent", IDC_ACCENT_MODE, 144, 209, 312, 25, BS_OWNERDRAW
    PUSHBUTTON "Custom color", IDC_CUSTOM_ACCENT, 144, 236, 312, 25, BS_OWNERDRAW
    CONTROL "Animate the island", IDC_ANIMATE_ISLAND, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 263, 312, 30
    CONTROL "Hide in fullscreen", IDC_HIDE_FULLSCREEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 295, 312, 30
    PUSHBUTTON "Preview sample", IDC_PREVIEW_ACTION, 315, 122, 131, 20, BS_OWNERDRAW
    PUSHBUTTON "Start", IDC_PREVIEW_TIMER, 154, 122, 65, 20, BS_OWNERDRAW
    PUSHBUTTON "Dot", IDC_PREVIEW_DOT, 154, 122, 35, 20, BS_OWNERDRAW
    PUSHBUTTON "Pill", IDC_PREVIEW_PILL, 191, 122, 35, 20, BS_OWNERDRAW
    PUSHBUTTON "Panel", IDC_PREVIEW_PANEL, 228, 122, 42, 20, BS_OWNERDRAW
    PUSHBUTTON "Pause", IDC_PREVIEW_PLAY, 154, 122, 65, 20, BS_OWNERDRAW
    PUSHBUTTON "Copy sample text", IDC_PREVIEW_COPY_TEXT, 154, 122, 110, 20, BS_OWNERDRAW
    PUSHBUTTON "Copy sample screenshot", IDC_PREVIEW_COPY_IMAGE, 268, 122, 146, 20, BS_OWNERDRAW
    PUSHBUTTON "System status", IDC_PREVIEW_STATUS, 154, 122, 100, 20, BS_OWNERDRAW
    PUSHBUTTON "Audio output", IDC_PREVIEW_AUDIO, 258, 122, 100, 20, BS_OWNERDRAW
    PUSHBUTTON "All features", IDC_FEATURE_BACK, 144, 9, 88, 18, BS_OWNERDRAW
    CONTROL "Show in the island", IDC_FEATURE_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 154, 312, 30
    CONTROL "Show waveform", IDC_SHOW_WAVEFORM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 187, 312, 30
    CONTROL "Show lyrics in the pill", IDC_PILL_LYRICS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 220, 312, 30
    PUSHBUTTON "Compact after pausing", IDC_PAUSE_DELAY, 144, 253, 312, 30, BS_OWNERDRAW
    PUSHBUTTON "Default focus duration", IDC_FOCUS_DURATION, 144, 187, 312, 30, BS_OWNERDRAW
    PUSHBUTTON "Default break duration", IDC_BREAK_DURATION, 144, 220, 312, 30, BS_OWNERDRAW
    CONTROL "Cycle Focus and Break", IDC_AUTO_CYCLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 253, 312, 30
    CONTROL "Add copied text", IDC_ADD_COPIED_TEXT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 187, 312, 30
    CONTROL "Auto-add screenshots", IDC_ADD_SCREENSHOTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 220, 312, 30
    CONTROL "Show clipboard previews", IDC_CLIPBOARD_PREVIEWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 253, 312, 30
    PUSHBUTTON "Move up", IDC_FEATURE_UP, 326, 296, 62, 23, BS_OWNERDRAW
    PUSHBUTTON "Move down", IDC_FEATURE_DOWN, 391, 296, 65, 23, BS_OWNERDRAW
    EDITTEXT IDC_SAMPLE_NOTE, 157, 93, 286, 43, ES_MULTILINE | ES_AUTOVSCROLL | WS_TABSTOP
    PUSHBUTTON "Now Playing", IDC_FEATURE_MEDIA, 144, 69, 312, 36, BS_OWNERDRAW
    PUSHBUTTON "Timers", IDC_FEATURE_TIMERS, 144, 110, 312, 36, BS_OWNERDRAW
    PUSHBUTTON "Scratchpad", IDC_FEATURE_SCRATCH, 144, 151, 312, 36, BS_OWNERDRAW
    PUSHBUTTON "Drop Zone", IDC_FEATURE_DROP, 144, 192, 312, 36, BS_OWNERDRAW
    PUSHBUTTON "System", IDC_FEATURE_SYSTEM, 144, 233, 312, 36, BS_OWNERDRAW
    CONTROL "Enable Now Playing", IDC_ENABLE_MEDIA, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 416, 69, 40, 36
    CONTROL "Enable Timers", IDC_ENABLE_TIMERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 416, 110, 40, 36
    CONTROL "Enable Scratchpad", IDC_ENABLE_SCRATCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 416, 151, 40, 36
    CONTROL "Enable Drop Zone", IDC_ENABLE_DROP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 416, 192, 40, 36
    CONTROL "Enable System", IDC_ENABLE_SYSTEM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 416, 233, 40, 36
    PUSHBUTTON "View on GitHub", IDC_SETTINGS_GITHUB, 144, 105, 113, 26, BS_OWNERDRAW
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Zenith Dot"
            VALUE "FileVersion", ZENITH_VERSION_TEXT
            VALUE "ProductName", "Zenith Dot"
            VALUE "ProductVersion", ZENITH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
