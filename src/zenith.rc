#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "zenith.manifest"
IDI_ZENITH_DOT ICON "zenith.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Zenith Dot"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Zenith Dot"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
