#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "zenith.manifest"
IDI_ZENITH_DOT ICON "zenith.ico"

IDD_SETTINGS DIALOGEX 0, 0, 242, 151
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Zenith Dot Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "General", -1, 12, 9, 218, 36
    CONTROL "&Start with Windows", IDC_START_WITH_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 24, 198, 12
    GROUPBOX "Drop Zone", -1, 12, 51, 218, 66
    CONTROL "Add copied &text to Drop Zone", IDC_ADD_COPIED_TEXT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 66, 198, 12
    CONTROL "Auto-add screen&shots", IDC_ADD_SCREENSHOTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 82, 198, 12
    CONTROL "Show clipboard &previews", IDC_CLIPBOARD_PREVIEWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 98, 198, 12
    DEFPUSHBUTTON "Done", IDOK, 172, 125, 58, 16
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Zenith Dot"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Zenith Dot"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
