#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "zenith.manifest"
IDI_ZENITH_DOT ICON "zenith.ico"

IDD_PRAYER_LOCATION DIALOGEX 0, 0, 276, 249
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Prayer location"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Search by city, regency, province, or time zone", -1, 12, 10, 252, 11
    CONTROL "", IDC_PRAYER_SEARCH, "Edit", WS_TABSTOP | ES_AUTOHSCROLL, 33, 28, 224, 13
    LTEXT "", IDC_PRAYER_STATUS, 12, 50, 252, 11
    CONTROL "", IDC_PRAYER_RESULTS, "ListBox", WS_TABSTOP | WS_VSCROLL | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT, 12, 65, 252, 150
    LTEXT "Source: SIHAT Kemenag RI", IDC_PRAYER_SOURCE, 12, 229, 130, 11
    PUSHBUTTON "Cancel", IDCANCEL, 150, 223, 53, 20, BS_OWNERDRAW
    PUSHBUTTON "Select", IDOK, 209, 223, 55, 20, BS_OWNERDRAW
END

// Settings draws its pages itself and creates its controls in code.
IDD_SETTINGS DIALOGEX 0, 0, 490, 298
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Zenula Settings"
FONT 9, "Segoe UI"
BEGIN
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Zenula"
            VALUE "FileVersion", ZENITH_VERSION_TEXT
            VALUE "ProductName", "Zenula"
            VALUE "ProductVersion", ZENITH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
