#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "zenith.manifest"
IDI_ZENITH_DOT ICON "zenith.ico"

IDD_SETTINGS DIALOGEX 0, 0, 440, 292
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "Zenith Dot Settings"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "&General", IDC_SETTINGS_GENERAL, 12, 56, 98, 24, BS_OWNERDRAW
    PUSHBUTTON "&Display", IDC_SETTINGS_DISPLAY, 12, 84, 98, 24, BS_OWNERDRAW
    PUSHBUTTON "&Features", IDC_SETTINGS_FEATURES, 12, 112, 98, 24, BS_OWNERDRAW
    PUSHBUTTON "&About", IDC_SETTINGS_ABOUT, 12, 140, 98, 24, BS_OWNERDRAW
    CONTROL "Start with Windows", IDC_START_WITH_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 78, 274, 37
    CONTROL "Animate the island", IDC_ANIMATE_ISLAND, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 78, 274, 37
    CONTROL "Hide in fullscreen", IDC_HIDE_FULLSCREEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 116, 274, 37
    CONTROL "Add copied text to Drop Zone", IDC_ADD_COPIED_TEXT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 78, 274, 37
    CONTROL "Auto-add screenshots", IDC_ADD_SCREENSHOTS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 116, 274, 37
    CONTROL "Show clipboard previews", IDC_CLIPBOARD_PREVIEWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 154, 274, 37
    CONTROL "Cycle Focus and Break", IDC_AUTO_CYCLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 144, 223, 274, 37
    PUSHBUTTON "View on GitHub", IDC_SETTINGS_GITHUB, 144, 105, 113, 26, BS_OWNERDRAW
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Zenith Dot"
            VALUE "FileVersion", ZENITH_VERSION_TEXT
            VALUE "ProductName", "Zenith Dot"
            VALUE "ProductVersion", ZENITH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
