#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "zenith.manifest"
IDI_ZENITH_DOT ICON "zenith.ico"

IDD_PRAYER_LOCATION DIALOGEX 0, 0, 240, 246
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "Prayer location"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_PRAYER_SEARCH, "Edit", WS_TABSTOP | ES_AUTOHSCROLL, 28, 14, 196, 10
    LTEXT "", IDC_PRAYER_STATUS, 10, 34, 220, 9
    CONTROL "", IDC_PRAYER_RESULTS, "ListBox", WS_TABSTOP | WS_VSCROLL | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT, 11, 47, 218, 158
    LTEXT "Source: SIHAT Kemenag RI", IDC_PRAYER_SOURCE, 10, 227, 130, 9
    PUSHBUTTON "Select", IDOK, 0, 0, 0, 0, BS_OWNERDRAW | NOT WS_VISIBLE
    PUSHBUTTON "Cancel", IDCANCEL, 186, 222, 45, 18, BS_OWNERDRAW
END

// A dark Yes/No for actions that can't be undone. Focus starts on Cancel.
IDD_CONFIRM DIALOGEX 0, 0, 220, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Zenula Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_CONFIRM_TITLE, 12, 10, 196, 12, SS_NOPREFIX
    LTEXT "", IDC_CONFIRM_BODY, 12, 26, 196, 34, SS_NOPREFIX
    PUSHBUTTON "Cancel", IDCANCEL, 106, 68, 50, 16, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON "Reset", IDOK, 160, 68, 50, 16, BS_OWNERDRAW | WS_TABSTOP
END

// Settings draws its pages itself and creates its controls in code.
IDD_SETTINGS DIALOGEX 0, 0, 490, 298
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Zenula Settings"
FONT 9, "Segoe UI"
BEGIN
END

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Zenula"
            VALUE "FileVersion", ZENITH_VERSION_TEXT
            VALUE "ProductName", "Zenula"
            VALUE "ProductVersion", ZENITH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
