{
  "manifest_version": 3,
  "name": "Zenith Dot Browser Tabs",
  "version": "0.2.0",
  "description": "Send playback information and controls for individual media tabs to Zenith Dot.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "js": [
        "media.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
